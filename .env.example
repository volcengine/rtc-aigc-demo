RTC_APP_ID=
RTC_APP_KEY=

# Optional: configure both for direct OpenAPI signing. Leave both unset to use
# the vertc CLI quick-start mode injected by `vertc dev`.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

HOST=127.0.0.1
PORT=3001
VOLCENGINE_RTC_ENDPOINT=https://rtc.volcengineapi.com
VOLCENGINE_RTC_REGION=cn-north-1
VOLCENGINE_RTC_SERVICE=rtc
VOLCENGINE_RTC_API_VERSION=2025-06-01
